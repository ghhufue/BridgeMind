{
  "name": "bridgemind-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test scripts/check-publish-release.mjs",
    "android:build": "node scripts/android-debug.mjs",
    "android:release": "node scripts/android-debug.mjs --release",
    "release:publish": "node scripts/github-release.mjs",
    "android:publish": "node scripts/android-debug.mjs --publish",
    "android:install": "node scripts/android-debug.mjs --install"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "gsap": "3.15.0",
    "howler": "2.2.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@testing-library/react": "16.3.3",
    "@types/howler": "2.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
